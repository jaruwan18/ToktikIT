generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  REQUESTER
  IT_STAFF
  ADMIN
}

enum RequestedPriority {
  LOW
  MEDIUM
  HIGH
}

enum CurrentStatus {
  NEW
  IN_PROGRESS
  WAITING_FOR_REQUESTER
  RESOLVED
  CLOSED
}

enum TicketMessageType {
  COMMENT
  INTERNAL_NOTE
}

model User {
  id                Int      @id @default(autoincrement())
  email             String   @unique
  displayName       String
  passwordHash      String
  role              Role
  mustChangePassword Boolean  @default(true)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  requester Requester?
  ownedTickets Ticket[] @relation("TicketOwner")
  messages TicketMessage[] @relation("MessageAuthor")
}

model Requester {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  userId Int? @unique
  user   User? @relation(fields: [userId], references: [id])

  tickets Ticket[]
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model Ticket {
  id                Int               @id @default(autoincrement())
  ticketNumber      String            @unique
  requesterId       Int
  categoryId        Int
  relatedSystemId   Int
  ownerId           Int?
  summary           String
  description       String
  requestedPriority RequestedPriority
  currentStatus     CurrentStatus     @default(NEW)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  requester     Requester     @relation(fields: [requesterId], references: [id])
  category      Category      @relation(fields: [categoryId], references: [id])
  relatedSystem RelatedSystem @relation(fields: [relatedSystemId], references: [id])
  owner         User?         @relation("TicketOwner", fields: [ownerId], references: [id])
  attachments   Attachment[]
  messages      TicketMessage[]

  @@index([requesterId])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([ownerId])
  @@index([currentStatus])
}

model Attachment {
  id               Int       @id @default(autoincrement())
  ticketId         Int
  originalFilename String
  storedFilename   String
  mimeType         String
  sizeBytes        Int
  uploadedAt       DateTime  @default(now())
  isRemoved        Boolean   @default(false)
  removedAt        DateTime?
  removalReason    String?

  ticket Ticket @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

model TicketMessage {
  id        Int               @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  type      TicketMessageType
  body      String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  ticket Ticket @relation(fields: [ticketId], references: [id])
  author User   @relation("MessageAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([authorId])
}